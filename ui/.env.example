# Copy to .env for local use and fill in. NEVER commit real values.
# From your Meta developer app (WhatsApp Business Platform):
WHATSAPP_VERIFY_TOKEN=choose-a-long-random-string
WHATSAPP_APP_SECRET=your-app-secret
WHATSAPP_ACCESS_TOKEN=your-access-token
WHATSAPP_PHONE_NUMBER_ID=your-phone-number-id
# Optional:
WHATSAPP_API_VERSION=v21.0
SCAMHELPER_COUNTRY=MY
PORT=8080
# Local testing only (skips signature checks). Leave unset in any real deployment:
# ALLOW_UNSIGNED=1
